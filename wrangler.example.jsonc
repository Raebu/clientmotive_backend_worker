{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "clientmotive-backend-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_ORIGIN": "https://www.clientmotive.com",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_STRONG_MODEL": "@cf/zai-org/glm-4.7-flash",
    "SEARCH_PROVIDER": "tavily",
    "MAX_SEARCHES_PER_LEAD": "12",
    "MAX_PAGES_PER_COMPANY": "8",
    "INTENT_EVENT_RETENTION_DAYS": "90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clientmotive-revenue-intelligence",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "RESEARCH_QUEUE",
        "queue": "clientmotive-research"
      }
    ],
    "consumers": [
      {
        "queue": "clientmotive-research",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "clientmotive-research-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "27182818",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "INTAKE_RATE_LIMITER",
      "namespace_id": "27182819",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["17 2 * * *"]
  }
}
